# SpecMatrix AI Konfigürasyon Dosyası Örneği

# LLM Sağlayıcı Seçimi: 'ollama' (Yerel model - Önerilen), 'openai' veya 'mock'
LLM_PROVIDER=ollama

# Yerel Ollama Yapılandırması (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_TIMEOUT=120.0

# Vektör Gömme (Embedding) Sağlayıcısı: 'deterministic' (hızlı ve yerel), 'ollama', veya 'openai'
EMBEDDING_PROVIDER=deterministic

# OpenAI API Anahtarı (Opsiyonel - Yalnızca LLM_PROVIDER=openai seçildiğinde gereklidir)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Uygulama Ayarları
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# RAG & Chunking Parametreleri
CHUNK_SIZE=650
CHUNK_OVERLAP=100
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_BM25_WEIGHT=0.5
TOP_K_CHUNKS=3
